# Clocker environment template.
# Copy to `.env` (git-ignored) and fill in. Never commit real values.
# docker-compose reads `.env` automatically. Production values live in Railway service variables.
# Variables marked (Phase N) are not used yet. Fill them in when that phase starts.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Public URLs
# Dev:  http://localhost:3000 / :3001 / :4000
# Prod: https://app.getclocker.app / https://admin.getclocker.app / https://api.getclocker.app
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000

# (Phase 1) Browser origins allowed to call the API, comma-separated, exact match.
# Prod: https://app.getclocker.app,https://admin.getclocker.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# (Phase 3) Session cookie domain. Empty for localhost. Prod: .getclocker.app
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Redis (cache, rate limits, job queue)
# Local Docker sets REDIS_URL for you from REDIS_PASSWORD.
# Prod: use Railway Redis's private URL (redis://default:...@redis.railway.internal:6379)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=devpassword
# Only needed when running the API outside Docker (pnpm dev):
REDIS_URL=redis://:devpassword@localhost:6379

# ---------------------------------------------------------------------------
# Neon Postgres (Phase 1)
# Neon console > Clocker App > branch `dev` > Connect.
# DATABASE_URL: pooled connection string (host contains "-pooler"), runtime role `app_user`.
#   We create the `app_user` role in Phase 1. Until then, use the owner string.
# DATABASE_MIGRATION_URL: direct (non-pooled) string, owner role. Used only for migrations.
# Both must include ?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=
DATABASE_MIGRATION_URL=

# Throwaway test databases: each test run creates a Neon branch from NEON_PARENT_BRANCH
# and deletes it afterwards.
# Neon console > Organization/Account settings > API keys. Prefer a key scoped to this project.
# Keep it only in this local .env (and later in GitHub Actions secrets). Never in Railway or git.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_PARENT_BRANCH=dev

# ---------------------------------------------------------------------------
# Auth (Phase 3)
# Generate with: openssl rand -base64 48
# Use a different value in every environment.
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=

# ---------------------------------------------------------------------------
# Email via Resend (Phase 2)
# Leave RESEND_API_KEY empty in development: emails are printed to the API/worker logs instead.
# Sending domain: mail.getclocker.app (verify it in Resend and add the DNS records it gives you).
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Clocker <no-reply@mail.getclocker.app>"

# ---------------------------------------------------------------------------
# Lemon Squeezy billing (Phase 4)
# ---------------------------------------------------------------------------
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
