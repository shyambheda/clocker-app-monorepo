# Environment template for the SaaS starter.
# Copy this file to `.env` (git ignores it) and set the values. Do not commit real values.
# Docker Compose reads `.env` automatically. Production values are Railway service variables.
# The code does not use variables marked (Phase N) yet. Set them when that phase starts.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Product identity (each product sets its own values)
# APP_NAME: the API and the worker use it (logs, and emails from Phase 3).
# NEXT_PUBLIC_APP_NAME: the web app and the admin app show it. Next.js puts it into the build,
#   thus a change needs a new build. Use the same value as APP_NAME.
# ---------------------------------------------------------------------------
APP_NAME="SaaS Starter"
NEXT_PUBLIC_APP_NAME="SaaS Starter"

# ---------------------------------------------------------------------------
# Public URLs
# Dev:  http://localhost:3000 / :3001 / :4000
# Prod: https://app.example.com / https://admin.example.com / https://api.example.com
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000

# Browser origins that can call the API. Separate them with commas. The match is exact:
# scheme, host and port only, no path, no slash at the end, no *. The API adds the origin of
# API_URL itself. A request from a different origin gets 403.
# Prod: https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------------------------------------------------------------------------
# API security
# TRUST_PROXY_HOPS: number of reverse proxies in front of the API (0 to 5).
#   0 locally, 1 on Railway. A wrong value gives a wrong client IP to the rate limit.
# RATE_LIMIT_MAX / RATE_LIMIT_WINDOW_MS: requests for each IP in each window (shared in Redis).
# ---------------------------------------------------------------------------
TRUST_PROXY_HOPS=0
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# (Phase 4) Domain of the session cookie. Keep it empty for localhost. Prod: .example.com
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Redis (cache, rate limits, job queue)
# In Docker Compose, the API and the worker get REDIS_URL from REDIS_PASSWORD automatically.
# Prod: use the private URL of Railway Redis (redis://default:...@redis.railway.internal:6379).
# ---------------------------------------------------------------------------
REDIS_PASSWORD=devpassword
# Use this value only when the API runs outside Docker (pnpm dev):
REDIS_URL=redis://:devpassword@localhost:6379

# ---------------------------------------------------------------------------
# Neon Postgres
# Neon console > your project > branch `dev` > Connect.
# DATABASE_URL: pooled connection string (the host contains "-pooler"). Runtime role `app_user`.
#   Make the password with: openssl rand -hex 24
#   The migrate script makes the role and sets this password on it. Thus you do not make
#   app_user in the Neon console.
# DATABASE_MIGRATION_URL: direct (not pooled) connection string. Owner role. Only migrations use it.
# The two strings must include ?sslmode=require
# Example: postgresql://app_user:<password>@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=
DATABASE_MIGRATION_URL=

# ---------------------------------------------------------------------------
# Integration tests
# `pnpm test:integration`: local Postgres and Redis containers. Only Docker is necessary.
# `pnpm test:neon`: each run makes a Neon branch from NEON_PARENT_BRANCH and deletes it after
#   the run. It also uses a Redis container (Docker is necessary).
# Neon console > Organization/Account settings > API keys. Use a key for this project only.
# Keep the key only in this local .env (and later in GitHub Actions secrets). Not in Railway or git.
# TEST_DB_PROVIDER (local or neon) is optional: the two pnpm scripts set it.
# ---------------------------------------------------------------------------
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_PARENT_BRANCH=dev

# ---------------------------------------------------------------------------
# Auth (Phase 4)
# Make the value with: openssl rand -base64 48
# Use a different value in each environment.
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=

# ---------------------------------------------------------------------------
# Email via Resend (Phase 3)
# Keep RESEND_API_KEY empty in development. Then the API and the worker write emails to the log.
# Sending domain: mail.example.com (verify it in Resend and add the DNS records that Resend gives).
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="SaaS Starter <no-reply@mail.example.com>"

# ---------------------------------------------------------------------------
# Lemon Squeezy billing (Phase 5)
# ---------------------------------------------------------------------------
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
