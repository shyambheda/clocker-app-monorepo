{
  "name": "@clocker/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clocker/shared": "workspace:*",
    "close-with-grace": "^2.5.0",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@clocker/config": "workspace:*",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
